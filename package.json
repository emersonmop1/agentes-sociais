{
  "name": "agentes-sociais",
  "version": "0.1.0",
  "private": true,
  "description": "Hub de agentes IA para redes sociais e copywriting (multi-tenant SaaS)",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @agentes/api dev",
    "dev:worker": "pnpm --filter @agentes/worker dev",
    "dev:web": "pnpm --filter @agentes/web dev",
    "build": "pnpm --filter @agentes/shared build && pnpm -r --filter '!@agentes/shared' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "packageManager": "pnpm@10.33.2"
}
