# ─── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-side only, NEVER expose
SUPABASE_JWT_SECRET=...             # legacy HS256 (fallback only)

# ─── Database ──────────────────────────────────────────────────
# For Supabase Cloud, use the SESSION POOLER (port 5432, IPv4-friendly):
#   postgresql://postgres.<project-ref>:<URL-encoded-password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
# The "aws-N" prefix and region come from the Supabase dashboard → Settings → Database.
# URL-encode the password: chars like + → %2B, % → %25, @ → %40.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ─── API server ────────────────────────────────────────────────
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
WEB_PUBLIC_URL=http://localhost:5173
NODE_ENV=development

# Random 32-byte hex string used to encrypt OAuth tokens at rest (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ─── LLM providers ─────────────────────────────────────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Image search (start with Unsplash + Pexels in MVP) ────────
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=

# ─── Instagram Graph API (Fatia 4) ─────────────────────────────
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ─── YouTube / Google (Fatia 7+) ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Frontend (Vite expõe como import.meta.env.VITE_*) ─────────
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
