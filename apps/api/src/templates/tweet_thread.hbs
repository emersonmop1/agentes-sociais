<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8" />
<style>
  @font-face {
    font-family: 'Inter Local';
    src: local('Inter'), local('Helvetica'), local('Arial');
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1080px; height: 1350px; }
  body {
    font-family: 'Inter Local', system-ui, -apple-system, sans-serif;
    background: {{brand.background_color}};
    color: {{brand.text_color}};
    -webkit-font-smoothing: antialiased;
  }
  .slide {
    width: 1080px; height: 1350px;
    padding: 60px 60px 80px;
    display: flex; flex-direction: column;
    justify-content: space-between;
  }
  .header { display: flex; align-items: center; gap: 16px; }
  .avatar {
    width: 80px; height: 80px; border-radius: 50%;
    background: linear-gradient(135deg, {{brand.primary_color}}, {{brand.secondary_color}});
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-weight: 700; font-size: 36px;
    overflow: hidden;
  }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }
  .user .name { font-size: 28px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
  .badge {
    width: 28px; height: 28px; border-radius: 50%;
    background: {{brand.primary_color}}; color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 16px; font-weight: 700;
  }
  .user .handle { font-size: 22px; color: #6b7280; margin-top: 4px; }

  .image-wrap {
    width: 100%; height: 480px; border-radius: 24px;
    overflow: hidden; position: relative; margin-top: 32px;
    background: #f1f5f9;
  }
  .image-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .credit {
    position: absolute; bottom: 12px; right: 12px;
    background: rgba(0,0,0,0.55); color: #fff;
    padding: 4px 10px; border-radius: 8px;
    font-size: 14px; font-weight: 500;
  }

  .content { margin-top: 28px; flex: 1; }
  .title {
    font-size: 64px; font-weight: 700; line-height: 1.15;
    letter-spacing: -1.5px;
  }
  .title.cover {
    font-size: 78px; line-height: 1.1; letter-spacing: -2px;
  }
  .subtitle {
    font-size: 36px; line-height: 1.3; margin-top: 24px;
    color: #6b7280; font-weight: 500;
  }
  .body {
    font-size: 28px; line-height: 1.45; margin-top: 18px;
    color: #6b7280;
  }

  .footer {
    margin-top: auto; padding-top: 24px;
    display: flex; align-items: center; justify-content: space-between;
    color: #9ca3af; font-size: 22px;
  }
  .swipe { display: flex; align-items: center; gap: 8px; }
  .cta-pill {
    background: {{brand.primary_color}}; color: #fff;
    padding: 12px 28px; border-radius: 100px;
    font-size: 24px; font-weight: 700;
  }
</style>
</head>
<body>
  <div class="slide">
    <header class="header">
      <div class="avatar">{{#if brand.avatar_url}}<img src="{{brand.avatar_url}}" />{{else}}{{brand.initial}}{{/if}}</div>
      <div class="user">
        <div class="name">
          {{brand.brand_name}}
          {{#if brand.badge_verified}}<span class="badge">✓</span>{{/if}}
        </div>
        <div class="handle">{{brand.handle}}</div>
      </div>
    </header>

    {{#if image}}
    <div class="image-wrap">
      <img src="{{image.url}}" />
      {{#if image.credit}}<div class="credit">{{image.credit}}</div>{{/if}}
    </div>
    {{/if}}

    <div class="content">
      <h1 class="title{{#if is_cover}} cover{{/if}}">{{title}}</h1>
      {{#if subtitle}}<p class="subtitle">{{subtitle}}</p>{{/if}}
      {{#if body}}<p class="body">{{body}}</p>{{/if}}
    </div>

    <footer class="footer">
      {{#if is_cta}}
        <span class="cta-pill">{{brand.handle}}</span>
      {{else}}
        <span>{{brand.handle}}</span>
        {{#unless is_cover_or_cta}}
          <span class="swipe">arrasta →</span>
        {{/unless}}
      {{/if}}
    </footer>
  </div>
</body>
</html>
