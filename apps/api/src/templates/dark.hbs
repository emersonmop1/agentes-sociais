<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8" />
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1080px; height: 1350px; }
  body {
    font-family: system-ui, -apple-system, 'Inter', 'Helvetica Neue', sans-serif;
    background: #000;
    color: #fff;
    -webkit-font-smoothing: antialiased;
  }
  .slide {
    width: 1080px; height: 1350px;
    position: relative; overflow: hidden;
    display: flex; flex-direction: column; justify-content: flex-end;
  }
  .bg-image { position: absolute; inset: 0; z-index: 0; }
  .bg-image img { width: 100%; height: 100%; object-fit: cover; opacity: 0.65; }
  .bg-image::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.85) 100%);
  }
  .content {
    position: relative; z-index: 1;
    padding: 60px 60px 100px;
  }
  .title {
    font-size: 84px; font-weight: 800; line-height: 1.05;
    letter-spacing: -2.5px;
    text-shadow: 0 4px 18px rgba(0,0,0,0.5);
  }
  .title.cover { font-size: 96px; }
  .subtitle {
    font-size: 36px; line-height: 1.3; margin-top: 28px;
    color: #d4d4d8; font-weight: 500;
  }
  .body {
    font-size: 28px; line-height: 1.45; margin-top: 20px;
    color: #d4d4d8;
  }
  .footer {
    margin-top: 40px;
    display: flex; align-items: center; justify-content: space-between;
    color: rgba(255,255,255,0.5); font-size: 22px; font-weight: 500;
  }
  .cta-pill {
    background: {{brand.primary_color}}; color: #fff;
    padding: 14px 32px; border-radius: 100px;
    font-size: 28px; font-weight: 700;
    box-shadow: 0 4px 24px {{brand.primary_color}}50;
  }
  .credit {
    position: absolute; bottom: 16px; right: 16px; z-index: 2;
    background: rgba(0,0,0,0.6); color: rgba(255,255,255,0.7);
    padding: 6px 12px; border-radius: 6px;
    font-size: 14px;
  }
</style>
</head>
<body>
  <div class="slide">
    {{#if image}}
    <div class="bg-image">
      <img src="{{image.url}}" />
    </div>
    {{#if image.credit}}<div class="credit">{{image.credit}}</div>{{/if}}
    {{/if}}

    <div class="content">
      <h1 class="title{{#if is_cover}} cover{{/if}}">{{title}}</h1>
      {{#if subtitle}}<p class="subtitle">{{subtitle}}</p>{{/if}}
      {{#if body}}<p class="body">{{body}}</p>{{/if}}

      <div class="footer">
        {{#if is_cta}}
          <span class="cta-pill">{{brand.handle}}</span>
        {{else}}
          <span>{{brand.handle}}</span>
          {{#unless is_cover_or_cta}}<span>arrasta →</span>{{/unless}}
        {{/if}}
      </div>
    </div>
  </div>
</body>
</html>
