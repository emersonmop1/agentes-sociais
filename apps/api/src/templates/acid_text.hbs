<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8" />
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1080px; height: 1350px; }
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background: #fff;
    color: #0f172a;
    -webkit-font-smoothing: antialiased;
  }
  .slide {
    width: 1080px; height: 1350px;
    padding: 60px 60px 80px;
    display: flex; flex-direction: column;
  }
  .header { display: flex; align-items: center; gap: 16px; }
  .avatar {
    width: 80px; height: 80px; border-radius: 50%;
    background: linear-gradient(135deg, {{brand.primary_color}}, {{brand.secondary_color}});
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-weight: 700; font-size: 36px; overflow: hidden;
  }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }
  .user .name { font-size: 28px; font-weight: 700; }
  .user .handle { font-size: 22px; color: #6b7280; margin-top: 4px; }

  .content {
    flex: 1; display: flex; align-items: center; justify-content: center;
    padding: 40px 0;
  }
  .title {
    font-size: 96px; font-weight: 800; line-height: 1.05;
    letter-spacing: -3px;
    text-align: left;
  }
  .title.cover { font-size: 110px; }
  .highlight { color: {{brand.primary_color}}; }
  .subtitle {
    font-size: 42px; line-height: 1.3; margin-top: 36px;
    color: #6b7280; font-weight: 500;
  }

  .footer {
    margin-top: auto;
    display: flex; align-items: center; justify-content: space-between;
    color: #9ca3af; font-size: 22px;
  }
  .cta-pill {
    background: {{brand.primary_color}}; color: #fff;
    padding: 14px 32px; border-radius: 100px;
    font-size: 28px; font-weight: 700;
  }
</style>
</head>
<body>
  <div class="slide">
    <header class="header">
      <div class="avatar">{{#if brand.avatar_url}}<img src="{{brand.avatar_url}}" />{{else}}{{brand.initial}}{{/if}}</div>
      <div class="user">
        <div class="name">{{brand.brand_name}}</div>
        <div class="handle">{{brand.handle}}</div>
      </div>
    </header>

    <div class="content">
      <div>
        <h1 class="title{{#if is_cover}} cover{{/if}}">{{title}}</h1>
        {{#if subtitle}}<p class="subtitle">{{subtitle}}</p>{{/if}}
      </div>
    </div>

    <footer class="footer">
      {{#if is_cta}}
        <span class="cta-pill">{{brand.handle}}</span>
      {{else}}
        <span>{{brand.handle}}</span>
        {{#unless is_cover_or_cta}}<span>arrasta →</span>{{/unless}}
      {{/if}}
    </footer>
  </div>
</body>
</html>
